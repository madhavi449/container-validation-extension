{
  "manifest_version": 3,
  "name": "Container Validation",
  "version": "1.0",
  "description": "Automates validation of container numbers.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Container Validation"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/shipping-site.js"]
    }
  ]
}
