{
  "manifest_version": 3,
  "name": "Container Validation",
  "version": "2.2.0",
  "description": "Automates OceanCrest container validation.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "webNavigation",
    "tabs",
    "debugger"
  ],
  "host_permissions": [
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Container Validation"
  }
}